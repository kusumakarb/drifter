# ============================================================================
# .dockerignore - Exclude unnecessary files from Docker build context
# ============================================================================

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments (don't copy host venv)
.venv/
venv/
ENV/
env/
.virtualenvs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing and coverage
.coverage
htmlcov/
*.cover
.hypothesis/
.tox/

# Build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Git
.git/
.gitignore
.gitattributes

# Great Expectations uncommitted outputs (don't bake into image)
gx/uncommitted/validations/
gx/uncommitted/data_docs/
gx/uncommitted/*.yml
gx/uncommitted/*.json

# Project-specific outputs (transient)
outputs/
reports/
docker-outputs/

# Documentation and legacy code
legacy/
docs/
*.md
!README.md

# Test files (exclude from production image)
test_*.py
*_test.py
tests/
test_config.yaml

# Large data files (sample data is OK, but exclude large datasets)
*.csv.gz
*.parquet
food_delivery.csv

# CI/CD and deployment
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile
docker-compose.override.yml

# Lock files for other package managers (we have uv.lock)
Pipfile.lock
poetry.lock
requirements.txt

# Environment and secrets
.env
.env.*
*.pem
*.key
credentials.json
secrets/

# Claude Code plans
.claude/
